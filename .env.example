# ==============================================================================
# Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR TOKENS TO SOURCE CONTROL
# ==============================================================================

# Server Configuration
SERVER_PORT=30080
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=30081
A2A_AGENT_PORT=30082

# Authentication & Tokens (For remote HTTP / A2A / OAuth flows)
A2A_AUTH_TOKEN=your-a2a-bearer-token-here
MCP_AUTH_TOKEN=your-mcp-bearer-token-here

# API Keys (Optional Claude / Anthropic API keys for direct testing)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
